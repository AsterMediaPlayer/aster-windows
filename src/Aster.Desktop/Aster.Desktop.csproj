<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Built for Windows, the app reaches the system's media controls
         through WinRT, so it targets the Windows SDK; built for Linux (on
         Linux, or with a Linux runtime from Windows) it needn't. -->
    <TargetFramework Condition="'$(RuntimeIdentifier)' != '' And !$(RuntimeIdentifier.StartsWith('win'))">net10.0</TargetFramework>
    <TargetFramework Condition="'$(RuntimeIdentifier)' == '' And !$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <!-- SDL3's events, read for game controllers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The Apple app's version, which this port follows. -->
    <Version>0.10.1</Version>
    <!-- The .exe's icon (Windows); tools/icon makes it from the icon's layers. -->
    <ApplicationIcon Condition="$(TargetFramework.Contains('-windows'))">Assets\aster.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aster.Core\Aster.Core.csproj" />
    <ProjectReference Include="..\Aster.Mpv\Aster.Mpv.csproj" />
  </ItemGroup>
  <!-- SDL3 comes with phones' and tablets' libraries too, which a build for
       every platform at once would copy (into paths too long for Windows). -->
  <Target Name="LeaveOutMobileSdl" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
          Condition="'%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == 'ppy.SDL3-CS' And ('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'ios' Or $([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)').StartsWith('android')))" />
    </ItemGroup>
  </Target>
  <!-- A Linux or Mac build uses the system's libmpv; the Windows DLL, which
       comes along from Aster.Mpv, is left out of it. -->
  <Target Name="LeaveOutWindowsMpv" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != '' And !$(RuntimeIdentifier.StartsWith('win'))">
    <Delete Files="$(PublishDir)libmpv-2.dll" />
  </Target>

</Project>
