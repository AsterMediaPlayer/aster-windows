<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.Desktop.ViewModels"
             xmlns:c="using:Aster.Desktop.Controls"
             x:Class="Aster.Desktop.Views.LiveChannelGroupView"
             x:DataType="vm:LiveChannelGroupViewModel"
             Background="#141414">

    <UserControl.Styles>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,28,0,10" />
        </Style>
        <Style Selector="Border.group">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style Selector="Button.choice">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="64,80,64,60" MaxWidth="560" HorizontalAlignment="Left" IsEnabled="{Binding !IsSaving}">
                <TextBlock Text="Group" FontSize="32" FontWeight="Bold" />
                <TextBlock Text="{Binding Title}" Foreground="{StaticResource Secondary}" Margin="0,6,0,0" />

                <Border Classes="group" Margin="0,28,0,0">
                    <ItemsControl ItemsSource="{Binding Choices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GroupChoice">
                                <Button Classes="choice" Command="{Binding Pick}" c:KeyFocus.IsPreferred="{Binding IsCurrent}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE930;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SystemAccentColor}" IsVisible="{Binding IsCurrent}" />
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock Classes="heading" Text="New Group" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Theme="{StaticResource PillButton}" Content="Add" Command="{Binding AddCommand}" Margin="10,0,0,0" />
                    <TextBox Text="{Binding NewGroup}" PlaceholderText="New group…" AutomationProperties.Name="New group">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                </DockPanel>

                <TextBlock Text="{Binding Message}" Foreground="#FF6B6B" TextWrapping="Wrap" Margin="4,16,0,0"
                           IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </ScrollViewer>
        <!-- Back, for the pointer: the page sits over its tab. -->
        <Button x:Name="BackButton" ToolTip.Tip="Back (Alt+←)" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20"
                Width="44" Height="44" CornerRadius="22" Background="#B3000000" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0">
            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" />
        </Button>
    </Panel>
</UserControl>
