<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.Desktop.ViewModels"
             xmlns:c="using:Aster.Desktop.Controls"
             x:Class="Aster.Desktop.Views.AlbumView"
             x:DataType="vm:AlbumViewModel"
             Background="#141414">

    <Panel>
        <!-- The artwork, blurred and darkened, behind the page. -->
        <c:RemoteImage Url="{Binding Backdrop}">
            <c:RemoteImage.Effect>
                <BlurEffect Radius="80" />
            </c:RemoteImage.Effect>
        </c:RemoteImage>
        <Border Background="#B8000000" />

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="28" Margin="64,80,64,60">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="240" Height="240" CornerRadius="16" ClipToBounds="True" Background="#262626" BoxShadow="0 12 30 0 #80000000">
                        <Panel>
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="48" Opacity="0.35"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <c:RemoteImage Url="{Binding Artwork}" />
                        </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="12" Margin="32,0,0,0" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding Title}" FontSize="34" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2" />
                        <Button Content="{Binding ArtistName}" Command="{Binding OpenArtistCommand}" IsVisible="{Binding CanOpenArtist}"
                                Background="Transparent" Padding="0" FontSize="20" FontWeight="SemiBold" Cursor="Hand" />
                        <TextBlock Text="{Binding ArtistName}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Secondary}"
                                   IsVisible="{Binding !CanOpenArtist}" />
                        <TextBlock Text="{Binding InfoLine}" Foreground="{StaticResource Secondary}" />
                        <TextBlock Text="{Binding Overview}" Foreground="{StaticResource Secondary}" TextWrapping="Wrap" MaxLines="3"
                                   TextTrimming="CharacterEllipsis" MaxWidth="900" HorizontalAlignment="Left"
                                   IsVisible="{Binding Overview, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <WrapPanel ItemSpacing="12" LineSpacing="12" Margin="0,6,0,0" IsEnabled="{Binding HasTracks}">
                            <Button Theme="{StaticResource PillButton}" Classes="prominent" c:KeyFocus.IsPreferred="True" Command="{Binding PlayCommand}" AutomationProperties.Name="Play">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                    <TextBlock Text="Play" />
                                </StackPanel>
                            </Button>
                            <Button Theme="{StaticResource PillButton}" Command="{Binding ShuffleCommand}" AutomationProperties.Name="Shuffle">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                    <TextBlock Text="Shuffle" />
                                </StackPanel>
                            </Button>
                            <Button Theme="{StaticResource PillButton}" Command="{Binding InstantMixCommand}" Content="Instant Mix" />
                            <Button Theme="{StaticResource PillButton}" Command="{Binding AddToPlaylistCommand}" Content="Add to Playlist" IsVisible="{Binding CanAddToPlaylist}" />
                            <Button Theme="{StaticResource PillButton}" Command="{Binding ToggleFavoriteCommand}" ToolTip.Tip="Favorite" Width="44" Padding="0">
                                <Panel>
                                    <TextBlock Text="&#xEB52;" FontFamily="{StaticResource IconFont}" IsVisible="{Binding IsFavorite}" HorizontalAlignment="Center" />
                                    <TextBlock Text="&#xEB51;" FontFamily="{StaticResource IconFont}" IsVisible="{Binding !IsFavorite}" HorizontalAlignment="Center" />
                                </Panel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding Message}" Foreground="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,40"
                           IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ProgressBar IsIndeterminate="True" Width="200" IsVisible="{Binding IsLoading}" />

                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="vm:HeadingRow">
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8" />
                        </DataTemplate>
                        <DataTemplate DataType="vm:TrackItem">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TrackCard}" Margin="0,0,0,6" />
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Button Command="{Binding BackCommand}" ToolTip.Tip="Back (Alt+←)" AutomationProperties.Name="Back" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20"
                Width="44" Height="44" CornerRadius="22" Background="#B3000000" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0">
            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" />
        </Button>
    </Panel>
</UserControl>
