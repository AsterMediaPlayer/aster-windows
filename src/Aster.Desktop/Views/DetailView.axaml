<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.Desktop.ViewModels"
             xmlns:c="using:Aster.Desktop.Controls"
             x:Class="Aster.Desktop.Views.DetailView"
             x:DataType="vm:DetailViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="ChoiceTemplate" x:DataType="vm:Choice">
            <Button Theme="{StaticResource PillButton}" Classes.selected="{Binding IsSelected}" Command="{Binding Select}"
                    Content="{Binding Title}" MinHeight="36" Padding="16,6" />
        </DataTemplate>

        <!-- An opening or ending: "OP 1" (or the clip's length) on its picture, then the song, artist and where it's from. -->
        <!-- A version in a card's menu, the one Settings prefers ticked (as Settings' own lists, whose style is theirs alone). -->
        <ControlTheme x:Key="CutChoice" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:TrackChoice">
            <Setter Property="Header" Value="{Binding Title}" />
            <Setter Property="Command" Value="{Binding Select}" />
            <Setter Property="ToggleType" Value="Radio" />
            <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
        </ControlTheme>
        <DataTemplate x:Key="OpeningEndingTemplate" x:DataType="vm:OpeningEndingCard">
            <StackPanel Width="{StaticResource LandscapeWidth}" Spacing="8">
                <Button Theme="{StaticResource CardButton}" Command="{Binding PlayCommand}" IsEnabled="{Binding CanPlay}"
                        Width="{StaticResource LandscapeWidth}" Height="{StaticResource LandscapeHeight}"
                        AutomationProperties.Name="{Binding Title}">
                    <!-- A right click: the other versions (TV size, full, music video), where the plugin has them, and Add to Playlist. -->
                    <Button.ContextMenu>
                        <ContextMenu ItemsSource="{Binding Menu}" ItemContainerTheme="{StaticResource CutChoice}" IsVisible="{Binding HasMenu}" />
                    </Button.ContextMenu>
                    <Panel>
                        <TextBlock Text="{x:Static vm:OpeningEndingCard.Placeholder}" FontFamily="{StaticResource IconFont}" FontSize="36" Opacity="0.35"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <c:RemoteImage Url="{Binding Image}" IsVisible="{Binding !IsFlagged}" />
                        <!-- A spoiler or NSFW theme stays hidden behind a blur. -->
                        <c:RemoteImage Url="{Binding Image}" IsVisible="{Binding IsFlagged}">
                            <c:RemoteImage.Effect>
                                <BlurEffect Radius="28" />
                            </c:RemoteImage.Effect>
                        </c:RemoteImage>
                        <Border Classes="pill" HorizontalAlignment="Left" VerticalAlignment="Top"
                                IsVisible="{Binding Badge, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="{Binding Badge}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Border Classes="pill" IsVisible="{Binding HasFull}" ToolTip.Tip="Has its full-length song: right-click to play it">
                                <TextBlock Text="Full" />
                            </Border>
                            <Border Classes="pill" IsVisible="{Binding HasMusicVideo}" ToolTip.Tip="Has its music video: right-click to play it">
                                <TextBlock Text="MV" />
                            </Border>
                            <Border Classes="pill" IsVisible="{Binding IsAudioOnly}">
                                <TextBlock Text="Audio only" />
                            </Border>
                            <Border Classes="pill" IsVisible="{Binding Length, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="{Binding Length}" />
                            </Border>
                        </StackPanel>
                        <Border Classes="pill notice" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="{Binding Notice}" />
                        </Border>
                    </Panel>
                </Button>
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Artists}" FontSize="12" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding Artists, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.pill">
            <Setter Property="Background" Value="#99000000" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="10" />
        </Style>
        <Style Selector="Border.pill TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.pill.notice TextBlock">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="StackPanel > Border.pill">
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style Selector="Panel.still">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.8" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.still.video">
            <Setter Property="Opacity" Value="0" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- The backdrop stays put behind the page as it scrolls. -->
        <Panel>
            <!-- The still fades away from over the theme video (drawn in the shell, behind the page) once it plays. -->
            <Panel Classes="still" Classes.video="{Binding Theme.IsVideoShowing}">
                <Border Background="#141414" />
                <c:RemoteImage Url="{Binding Backdrop}" />
            </Panel>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                        <GradientStop Offset="0" Color="#1A000000" />
                        <GradientStop Offset="0.5" Color="#8C000000" />
                        <GradientStop Offset="1" Color="#F7000000" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="50%,50%">
                        <GradientStop Offset="0" Color="#B3000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Panel>

        <ScrollViewer x:Name="Page" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="28" Margin="0,0,0,60">
                <!-- The header: along the bottom of the window's first screen, over the backdrop. -->
                <Panel x:Name="HeaderHost" MinHeight="520">
                    <StackPanel Spacing="14" VerticalAlignment="Bottom" Margin="48,0,48,8">
                        <Panel HorizontalAlignment="Left" IsVisible="{Binding SeriesName, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <c:RemoteImage x:Name="SeriesLogo" Url="{Binding SeriesLogo}" Stretch="Uniform" MaxWidth="260" MaxHeight="80" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding SeriesName}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Secondary}"
                                       IsVisible="{Binding !#SeriesLogo.HasImage}" />
                        </Panel>
                        <Panel HorizontalAlignment="Left">
                            <c:RemoteImage x:Name="Logo" Url="{Binding Logo}" Stretch="Uniform" MaxWidth="420" MaxHeight="150" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Title}" FontSize="40" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2"
                                       IsVisible="{Binding !#Logo.HasImage}" />
                        </Panel>
                        <TextBlock Text="{Binding EpisodeCode}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Secondary}"
                                   IsVisible="{Binding EpisodeCode, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <ContentControl Content="{Binding Metadata}" ContentTemplate="{StaticResource MetadataTemplate}" />
                        <TextBlock Text="{Binding Tagline}" FontSize="18" FontStyle="Italic" Foreground="{StaticResource Secondary}"
                                   IsVisible="{Binding Tagline, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Text="{Binding Overview}" TextWrapping="Wrap" MaxLines="5" TextTrimming="CharacterEllipsis" MaxWidth="900" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding UpNextLine}" Foreground="{StaticResource Secondary}"
                                   IsVisible="{Binding UpNextLine, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                            <Button Theme="{StaticResource PillButton}" Classes="prominent" c:KeyFocus.IsPreferred="True" Command="{Binding PlayResumeCommand}" AutomationProperties.Name="Play" x:Name="PlayButton">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PlayLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Theme="{StaticResource PillButton}" Command="{Binding PlayFromBeginningCommand}" IsVisible="{Binding Resumable}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                    <TextBlock Text="From Beginning" />
                                </StackPanel>
                            </Button>
                            <Button Theme="{StaticResource PillButton}" Command="{Binding WatchCommand}" CommandParameter="OP" IsVisible="{Binding HasWatchOpening}"
                                    ToolTip.Tip="The opening, full screen">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                    <TextBlock Text="Watch OP" />
                                </StackPanel>
                            </Button>
                            <Button Theme="{StaticResource PillButton}" Command="{Binding WatchCommand}" CommandParameter="ED" IsVisible="{Binding HasWatchEnding}"
                                    ToolTip.Tip="The ending, full screen">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                    <TextBlock Text="Watch ED" />
                                </StackPanel>
                            </Button>
                            <Button Theme="{StaticResource PillButton}" Command="{Binding OpenDiscMenuCommand}" IsVisible="{Binding HasDiscMenu}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE8B2;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                    <TextBlock Text="Disc Menu" />
                                </StackPanel>
                            </Button>
                            <Button Theme="{StaticResource PillButton}" Command="{Binding ToggleFavoriteCommand}" ToolTip.Tip="Favorite" Width="44" Padding="0" IsVisible="{Binding CanFavorite}">
                                <Panel>
                                    <TextBlock Text="&#xEB51;" FontFamily="{StaticResource IconFont}" IsVisible="{Binding IsFavorite}" HorizontalAlignment="Center" />
                                    <TextBlock Text="&#xEB52;" FontFamily="{StaticResource IconFont}" IsVisible="{Binding !IsFavorite}" HorizontalAlignment="Center" />
                                </Panel>
                            </Button>
                            <Button Theme="{StaticResource PillButton}" Command="{Binding TogglePlayedCommand}" IsVisible="{Binding ShowsWatched}"
                                    ToolTip.Tip="Watched" Width="44" Padding="0">
                                <Panel>
                                    <TextBlock Text="&#xEC61;" FontFamily="{StaticResource IconFont}" IsVisible="{Binding IsPlayed}" HorizontalAlignment="Center" />
                                    <TextBlock Text="&#xE930;" FontFamily="{StaticResource IconFont}" IsVisible="{Binding !IsPlayed}" HorizontalAlignment="Center" />
                                </Panel>
                            </Button>
                            <Button Theme="{StaticResource PillButton}" ToolTip.Tip="More" AutomationProperties.Name="More" Width="44" Padding="0"
                                    IsVisible="{Binding CanAddToPlaylist}">
                                <TextBlock Text="•••" FontSize="12" HorizontalAlignment="Center" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Header="Add to Playlist…" Command="{Binding AddToPlaylistCommand}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Theme="{StaticResource PillButton}" Command="{Binding GoToSeriesCommand}" IsVisible="{Binding CanGoToSeries}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                    <TextBlock Text="Go to Series" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding Remaining}" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" Margin="6,0"
                                       IsVisible="{Binding Remaining, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Message}" Foreground="#FF8A80"
                                   IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </Panel>

                <!-- A show's page in tabs, so its episodes, extras and details aren't one long scroll. -->
                <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource ChoiceTemplate}" Margin="{StaticResource ScreenPadding}"
                              IsVisible="{Binding UsesSections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <StackPanel Spacing="8" IsVisible="{Binding ShowsEpisodes}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Seasons}" ItemTemplate="{StaticResource ChoiceTemplate}" Margin="48,0,48,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <c:ShelfView Title="Episodes" Items="{Binding Episodes}" ItemTemplate="{StaticResource LandscapeCard}" />
                </StackPanel>

                <!-- An anime show's Music tab: its openings, then its endings. -->
                <StackPanel Spacing="28" IsVisible="{Binding ShowsMusic}">
                    <!-- One after another in the Now Playing panel, in the rows' order or shuffled. -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="{StaticResource ScreenPadding}" IsVisible="{Binding CanPlayAll}">
                        <Button Theme="{StaticResource PillButton}" Classes="prominent" Command="{Binding PlayAllCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                <TextBlock Text="Play All" />
                            </StackPanel>
                        </Button>
                        <Button Theme="{StaticResource PillButton}" Command="{Binding ShuffleCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                <TextBlock Text="Shuffle" />
                            </StackPanel>
                        </Button>
                        <Button Theme="{StaticResource PillButton}" Command="{Binding AddAllToPlaylistCommand}" IsVisible="{Binding CanAddAllToPlaylist}"
                                Content="Add All to Playlist" />
                    </StackPanel>
                    <c:ShelfView Title="Openings" Items="{Binding Openings}" ItemTemplate="{StaticResource OpeningEndingTemplate}" />
                    <c:ShelfView Title="Endings" Items="{Binding Endings}" ItemTemplate="{StaticResource OpeningEndingTemplate}" />
                </StackPanel>

                <!-- An episode's page: the rest of its season, the next one in view. -->
                <c:ShelfView Title="Episodes" Items="{Binding SeasonEpisodes}" ItemTemplate="{StaticResource LandscapeCard}" ScrollTarget="{Binding StripTarget}" />

                <c:ShelfView Title="Extras" Items="{Binding Extras}" ItemTemplate="{StaticResource LandscapeCard}" IsVisible="{Binding ShowsExtras}" />
                <c:ShelfView Title="Related" Items="{Binding Similar}" ItemTemplate="{StaticResource LandscapeCard}" IsVisible="{Binding ShowsRelated}" />

                <StackPanel Spacing="28" IsVisible="{Binding ShowsDetails}">
                    <c:ShelfView Title="Cast &amp; Crew" Items="{Binding Cast}" ItemTemplate="{StaticResource PersonCard}" />
                    <StackPanel Spacing="16" Margin="{StaticResource ScreenPadding}"
                                IsVisible="{Binding HasInformation}">
                        <TextBlock Text="Information" FontSize="20" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Information}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:InfoRow">
                                    <StackPanel Spacing="4" Margin="0,0,24,20">
                                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Secondary}" />
                                        <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Button Command="{Binding BackCommand}" ToolTip.Tip="Back (Alt+←)" AutomationProperties.Name="Back" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20"
                Width="44" Height="44" CornerRadius="22" Background="#B3000000" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0">
            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" />
        </Button>

        <ProgressBar IsIndeterminate="True" Width="200" IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560" />
    </Panel>
</UserControl>
