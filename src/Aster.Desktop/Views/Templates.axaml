<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Aster.Desktop.ViewModels"
                    xmlns:c="using:Aster.Desktop.Controls">

    <!-- Sizes, after the Apple app's Lockup, at a desktop window's scale. -->
    <x:Double x:Key="LandscapeWidth">300</x:Double>
    <x:Double x:Key="LandscapeHeight">169</x:Double>
    <x:Double x:Key="PosterWidth">180</x:Double>
    <x:Double x:Key="PosterHeight">270</x:Double>
    <x:Double x:Key="PersonPhoto">120</x:Double>
    <x:Double x:Key="PersonWidth">136</x:Double>
    <Thickness x:Key="ScreenPadding">48,0</Thickness>
    <!-- Segoe on Windows; elsewhere (Linux) the same icons from Fluent UI System Icons, at Segoe's code points (tools/make-icon-font.py). -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets, avares://Aster.Desktop/Assets/Fonts#Aster Icons, avares://Aster.Desktop/Assets/Fonts#Aster Icons Filled</FontFamily>
    <SolidColorBrush x:Key="Secondary" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="CardBackground" Color="#262626" />

    <!-- A card's picture as a button: no chrome, a lift and an outline on hover or keyboard focus. -->
    <ControlTheme x:Key="CardButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    </Border>
                    <Border Name="Highlight" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="3" BorderBrush="Transparent" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.04)" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#Highlight">
            <Setter Property="BorderBrush" Value="#E6FFFFFF" />
        </Style>
        <Style Selector="^:focus-visible">
            <Setter Property="RenderTransform" Value="scale(1.04)" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#Highlight">
            <Setter Property="BorderBrush" Value="White" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="RenderTransform" Value="scale(1.0)" />
        </Style>
    </ControlTheme>

    <!-- A page's pill buttons: grey with white, or white with black for the main action. -->
    <ControlTheme x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#4DFFFFFF" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <!-- The keyboard's (or a remote's) pill: white and lifted, as the Apple TV's focus. -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#73FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="^.prominent">
            <Setter Property="Background" Value="#F2FFFFFF" />
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style Selector="^.prominent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style Selector="^.selected">
            <Setter Property="Background" Value="#F2FFFFFF" />
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style Selector="^.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style Selector="^:focus-visible">
            <Setter Property="RenderTransform" Value="scale(1.06)" />
        </Style>
        <Style Selector="^:focus-visible /template/ ContentPresenter">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="BoxShadow" Value="0 6 18 0 #80000000" />
        </Style>
    </ControlTheme>

    <!-- "2019 · PG-13 · 2 hr 9 min · Action" with its badge and rating. -->
    <DataTemplate x:Key="MetadataTemplate" x:DataType="vm:MetadataLine">
        <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBlock Text="{Binding Text}" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" />
            <Border IsVisible="{Binding HasBadge}" BorderBrush="#99FFFFFF" BorderThickness="1.5" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Secondary}" />
            </Border>
            <StackPanel IsVisible="{Binding HasRating}" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Rating}" Foreground="{StaticResource Secondary}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- 16:9 artwork with a title underneath, the Apple TV app's standard lockup. -->
    <DataTemplate x:Key="LandscapeCard" x:DataType="vm:ItemCard">
        <StackPanel Width="{StaticResource LandscapeWidth}" Spacing="8">
            <Button Theme="{StaticResource CardButton}" Command="{Binding OpenCommand}"
                    Width="{StaticResource LandscapeWidth}" Height="{StaticResource LandscapeHeight}"
                    ToolTip.Tip="{Binding Title}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding PlayLabel}" Command="{Binding PlayCommand}" IsVisible="{Binding CanPlay}" />
                        <MenuItem Header="Play from Beginning" Command="{Binding PlayFromBeginningCommand}" IsVisible="{Binding CanPlayFromBeginning}" />
                        <MenuItem Header="Open" Command="{Binding OpenCommand}" />
                        <MenuItem Header="Go to Series" Command="{Binding GoToSeriesCommand}" IsVisible="{Binding CanGoToSeries}" />
                        <MenuItem Header="Go to Season" Command="{Binding GoToSeasonCommand}" IsVisible="{Binding CanGoToSeason}" />
                        <Separator IsVisible="{Binding HasMenu}" />
                        <MenuItem Header="{Binding WatchedLabel}" Command="{Binding ToggleWatchedCommand}" IsVisible="{Binding HasMenu}" />
                        <MenuItem Header="{Binding FavoriteLabel}" Command="{Binding ToggleFavoriteCommand}" IsVisible="{Binding CanFavorite}" />
                        <MenuItem Header="Add to Playlist…" Command="{Binding AddToPlaylistCommand}" IsVisible="{Binding CanAddToPlaylist}" />
                    </ContextMenu>
                </Button.ContextMenu>
                <Panel>
                    <TextBlock Text="{Binding Placeholder}" FontFamily="{StaticResource IconFont}" FontSize="36" Opacity="0.35"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <c:RemoteImage Url="{Binding Image}" />
                    <ProgressBar IsVisible="{Binding HasProgress}" Value="{Binding Progress}" Minimum="0" Maximum="100"
                                 VerticalAlignment="Bottom" Margin="12,0,12,10" MinHeight="5" Height="5" CornerRadius="3"
                                 Foreground="White" Background="#4DFFFFFF" />
                    <Ellipse IsVisible="{Binding ShowsUnplayed}" Width="14" Height="14" Fill="{DynamicResource SystemAccentColor}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" />
                    <TextBlock IsVisible="{Binding ClickPlays}" Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="40"
                               Foreground="#D9FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
            </Button>
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Subtitle, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- An episode airing soon: the show's picture, its logo or name, the episode, and "Available" when it's out early. -->
    <DataTemplate x:Key="UpcomingCard" x:DataType="vm:UpcomingCard">
        <Button Theme="{StaticResource CardButton}" Command="{Binding OpenCommand}"
                Width="{StaticResource LandscapeWidth}" Height="{StaticResource LandscapeHeight}"
                AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding Title}">
            <Panel>
                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="36" Opacity="0.35"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <c:RemoteImage Url="{Binding Image}" />
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="50%,35%" EndPoint="50%,100%">
                            <GradientStop Offset="0" Color="#00000000" />
                            <GradientStop Offset="1" Color="#D9000000" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel Spacing="4" Margin="12" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                    <Panel HorizontalAlignment="Left">
                        <c:RemoteImage x:Name="Logo" Url="{Binding Logo}" Stretch="Uniform" MaxWidth="165" MaxHeight="47" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="276"
                                   IsVisible="{Binding !#Logo.HasImage}" />
                    </Panel>
                    <TextBlock Text="{Binding EpisodeLine}" FontSize="12" FontWeight="SemiBold" Foreground="#D9FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="276" />
                </StackPanel>
                <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="10" Padding="8,3" Margin="10"
                        HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding IsAvailable}">
                    <TextBlock Text="Available" FontSize="11" FontWeight="Bold" />
                </Border>
            </Panel>
        </Button>
    </DataTemplate>

    <!-- A Live TV programme that's on: its picture, channel, LIVE and progress, then its title and episode or time. -->
    <DataTemplate x:Key="ProgramCard" x:DataType="vm:ProgramCard">
        <StackPanel Width="{StaticResource LandscapeWidth}" Spacing="8">
            <Button Theme="{StaticResource CardButton}" Command="{Binding OpenCommand}"
                    Width="{StaticResource LandscapeWidth}" Height="{StaticResource LandscapeHeight}" AutomationProperties.Name="{Binding Title}">
                <Panel>
                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="36" Opacity="0.35"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <c:RemoteImage Url="{Binding Image}" />
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="50%,50%" EndPoint="50%,100%">
                                <GradientStop Offset="0" Color="#00000000" />
                                <GradientStop Offset="1" Color="#B3000000" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <DockPanel VerticalAlignment="Bottom" Margin="12,0,12,14">
                        <Border DockPanel.Dock="Right" Background="#E53935" CornerRadius="4" Padding="6,1" IsVisible="{Binding IsLive}">
                            <TextBlock Text="LIVE" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="{Binding ChannelLine}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ProgressBar IsVisible="{Binding HasProgress}" Value="{Binding Progress}" Minimum="0" Maximum="100"
                                 VerticalAlignment="Bottom" Margin="12,0,12,6" MinHeight="4" Height="4" CornerRadius="2"
                                 Foreground="White" Background="#4DFFFFFF" />
                </Panel>
            </Button>
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- A Live TV channel: its logo (or number) on a dark tile, what's on underneath; favourites from its menu. -->
    <DataTemplate x:Key="ChannelCard" x:DataType="vm:ChannelCard">
        <StackPanel Width="200" Spacing="8">
            <Button Theme="{StaticResource CardButton}" Command="{Binding PlayCommand}" Width="200" Height="113"
                    AutomationProperties.Name="{Binding Title}" ToolTip.Tip="{Binding Title}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Watch" Command="{Binding PlayCommand}" />
                        <MenuItem Header="{Binding FavoriteLabel}" Command="{Binding ToggleFavoriteCommand}" />
                        <MenuItem Header="Group…" Command="{Binding ChooseGroupCommand}" IsVisible="{Binding CanGroup}" />
                    </ContextMenu>
                </Button.ContextMenu>
                <Panel>
                    <Panel.Background>
                        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                            <GradientStop Offset="0" Color="#383838" />
                            <GradientStop Offset="1" Color="#1F1F1F" />
                        </LinearGradientBrush>
                    </Panel.Background>
                    <TextBlock Text="{Binding Badge}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !#ChannelLogo.HasImage}" />
                    <c:RemoteImage x:Name="ChannelLogo" Url="{Binding Logo}" Stretch="Uniform" Margin="22" />
                    <TextBlock Text="&#xEB52;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="8"
                               HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding IsFavorite}" />
                    <ProgressBar IsVisible="{Binding HasProgress}" Value="{Binding Progress}" Minimum="0" Maximum="100"
                                 VerticalAlignment="Bottom" Margin="10,0,10,8" MinHeight="4" Height="4" CornerRadius="2"
                                 Foreground="White" Background="#4DFFFFFF" />
                </Panel>
            </Button>
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding NowTitle}" FontSize="12" Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding NowTitle, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- A scheduled recording: red while it's recording, a clock until then. -->
    <DataTemplate x:Key="TimerCard" x:DataType="vm:TimerCard">
        <StackPanel Width="{StaticResource LandscapeWidth}" Spacing="8">
            <Button Theme="{StaticResource CardButton}" Command="{Binding OpenCommand}"
                    Width="{StaticResource LandscapeWidth}" Height="{StaticResource LandscapeHeight}" AutomationProperties.Name="{Binding Title}">
                <Panel>
                    <TextBlock Text="&#xE7C8;" FontFamily="{StaticResource IconFont}" FontSize="36" Opacity="0.35"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <c:RemoteImage Url="{Binding Image}" />
                    <Ellipse Width="14" Height="14" Fill="#E53935" Margin="12" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding IsRecording}" />
                    <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" Margin="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                               IsVisible="{Binding !IsRecording}" />
                </Panel>
            </Button>
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- A series recording rule: its picture, name and options in brief. -->
    <DataTemplate x:Key="SeriesRuleCard" x:DataType="vm:SeriesRuleCard">
        <StackPanel Width="{StaticResource LandscapeWidth}" Spacing="8">
            <Button Theme="{StaticResource CardButton}" Command="{Binding OpenCommand}"
                    Width="{StaticResource LandscapeWidth}" Height="{StaticResource LandscapeHeight}" AutomationProperties.Name="{Binding Title}">
                <Panel>
                    <TextBlock Text="&#xE7C8;" FontFamily="{StaticResource IconFont}" FontSize="36" Opacity="0.35"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <c:RemoteImage Url="{Binding Image}" />
                    <TextBlock Text="&#xE8EE;" FontFamily="{StaticResource IconFont}" Margin="12" HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Panel>
            </Button>
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- 2:3 poster artwork with the title and year underneath. -->
    <DataTemplate x:Key="PosterCard" x:DataType="vm:ItemCard">
        <StackPanel Width="{StaticResource PosterWidth}" Spacing="8">
            <Button Theme="{StaticResource CardButton}" Command="{Binding OpenCommand}"
                    Width="{StaticResource PosterWidth}" Height="{StaticResource PosterHeight}" ToolTip.Tip="{Binding Title}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding PlayLabel}" Command="{Binding PlayCommand}" IsVisible="{Binding CanPlay}" />
                        <MenuItem Header="Play from Beginning" Command="{Binding PlayFromBeginningCommand}" IsVisible="{Binding CanPlayFromBeginning}" />
                        <MenuItem Header="Open" Command="{Binding OpenCommand}" />
                        <MenuItem Header="Go to Series" Command="{Binding GoToSeriesCommand}" IsVisible="{Binding CanGoToSeries}" />
                        <MenuItem Header="Go to Season" Command="{Binding GoToSeasonCommand}" IsVisible="{Binding CanGoToSeason}" />
                        <Separator IsVisible="{Binding HasMenu}" />
                        <MenuItem Header="{Binding WatchedLabel}" Command="{Binding ToggleWatchedCommand}" IsVisible="{Binding HasMenu}" />
                        <MenuItem Header="{Binding FavoriteLabel}" Command="{Binding ToggleFavoriteCommand}" IsVisible="{Binding CanFavorite}" />
                        <MenuItem Header="Add to Playlist…" Command="{Binding AddToPlaylistCommand}" IsVisible="{Binding CanAddToPlaylist}" />
                    </ContextMenu>
                </Button.ContextMenu>
                <Panel>
                    <TextBlock Text="{Binding Placeholder}" FontFamily="{StaticResource IconFont}" FontSize="36" Opacity="0.35"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <c:RemoteImage Url="{Binding Image}" />
                    <ProgressBar IsVisible="{Binding HasProgress}" Value="{Binding Progress}" Minimum="0" Maximum="100"
                                 VerticalAlignment="Bottom" Margin="10,0,10,8" MinHeight="5" Height="5" CornerRadius="3"
                                 Foreground="White" Background="#4DFFFFFF" />
                </Panel>
            </Button>
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Subtitle, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- A library as a wide tile, its name over its picture. -->
    <DataTemplate x:Key="TileCard" x:DataType="vm:ItemCard">
        <Button Theme="{StaticResource CardButton}" Command="{Binding OpenCommand}"
                Width="{StaticResource LandscapeWidth}" Height="{StaticResource LandscapeHeight}">
            <Panel>
                <TextBlock Text="{Binding Placeholder}" FontFamily="{StaticResource IconFont}" FontSize="40" Opacity="0.35"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <c:RemoteImage Url="{Binding Image}" />
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="50%,50%" EndPoint="50%,100%">
                            <GradientStop Offset="0" Color="#00000000" />
                            <GradientStop Offset="1" Color="#BF000000" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="14" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
            </Panel>
        </Button>
    </DataTemplate>

    <!-- A chapter of a book: a speaker by the one playing, its title, and where it starts in the book. -->
    <DataTemplate x:Key="ChapterRowTemplate" x:DataType="vm:ChapterRow">
        <Button Command="{Binding Play}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,9" Margin="0,0,0,6"
                CornerRadius="10" Classes="track" Classes.current="{Binding IsCurrent}">
            <Grid ColumnDefinitions="28,*,Auto">
                <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Secondary}"
                           VerticalAlignment="Center" IsVisible="{Binding IsCurrent}" />
                <TextBlock Grid.Column="1" Text="{Binding Chapter.Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Start}" Foreground="{StaticResource Secondary}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Button>
    </DataTemplate>

    <!-- A cast or crew member: round picture, name and role; opens their filmography. -->
    <DataTemplate x:Key="PersonCard" x:DataType="vm:ItemCard">
        <StackPanel Width="{StaticResource PersonWidth}" Spacing="8">
            <Button Theme="{StaticResource CardButton}" Command="{Binding OpenCommand}" CornerRadius="60"
                    Width="{StaticResource PersonPhoto}" Height="{StaticResource PersonPhoto}" HorizontalAlignment="Center">
                <Panel>
                    <TextBlock Text="{Binding Placeholder}" FontFamily="{StaticResource IconFont}" FontSize="36" Opacity="0.35"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <c:RemoteImage Url="{Binding Image}" />
                </Panel>
            </Button>
            <TextBlock Text="{Binding Title}" FontWeight="Medium" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Secondary}" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </DataTemplate>

    <!-- Square artwork with a title underneath: albums, playlists and songs. -->
    <DataTemplate x:Key="SquareCard" x:DataType="vm:ItemCard">
        <StackPanel Width="{StaticResource PosterWidth}" Spacing="8">
            <Button Theme="{StaticResource CardButton}" Command="{Binding OpenCommand}"
                    Width="{StaticResource PosterWidth}" Height="{StaticResource PosterWidth}" ToolTip.Tip="{Binding Title}">
                <Panel>
                    <TextBlock Text="{Binding Placeholder}" FontFamily="{StaticResource IconFont}" FontSize="36" Opacity="0.35"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <c:RemoteImage Url="{Binding Image}" />
                </Panel>
            </Button>
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Subtitle, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Round artwork for an artist. -->
    <DataTemplate x:Key="RoundCard" x:DataType="vm:ItemCard">
        <StackPanel Width="{StaticResource PosterWidth}" Spacing="10">
            <Button Theme="{StaticResource CardButton}" Command="{Binding OpenCommand}" CornerRadius="80"
                    Width="160" Height="160" HorizontalAlignment="Center" ToolTip.Tip="{Binding Title}">
                <Panel>
                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="40" Opacity="0.35"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <c:RemoteImage Url="{Binding Image}" />
                </Panel>
            </Button>
            <TextBlock Text="{Binding Title}" FontWeight="Medium" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </DataTemplate>

    <!-- A book's cover, how far through it is, its title and author. -->
    <DataTemplate x:Key="BookCard" x:DataType="vm:AudiobookCard">
        <StackPanel Width="{StaticResource PosterWidth}" Spacing="8">
            <Button Theme="{StaticResource CardButton}" Command="{Binding Open}"
                    Width="{StaticResource PosterWidth}" Height="{StaticResource PosterWidth}" ToolTip.Tip="{Binding Title}">
                <Panel>
                    <TextBlock Text="&#xE82D;" FontFamily="{StaticResource IconFont}" FontSize="36" Opacity="0.35"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <c:RemoteImage Url="{Binding Cover}" />
                    <ProgressBar IsVisible="{Binding HasProgress}" Value="{Binding Progress}" Minimum="0" Maximum="100"
                                 VerticalAlignment="Bottom" Margin="10,0,10,8" MinHeight="5" Height="5" CornerRadius="3"
                                 Foreground="White" Background="#4DFFFFFF" />
                    <TextBlock IsVisible="{Binding IsFinished}" Text="&#xEC61;" FontFamily="{StaticResource IconFont}" FontSize="22"
                               Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" />
                </Panel>
            </Button>
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Subtitle, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- An author or series: a stack of its first covers, its name and how many books. -->
    <DataTemplate x:Key="BookShelfCard" x:DataType="vm:AudiobookShelfCard">
        <StackPanel Width="{StaticResource PosterWidth}" Spacing="8">
            <Button Command="{Binding Open}" Width="{StaticResource PosterWidth}" Height="{StaticResource PosterWidth}" Padding="0"
                    Background="Transparent" Cursor="Hand" ToolTip.Tip="{Binding Title}">
                <Panel>
                    <Border Width="162" Height="162" CornerRadius="8" ClipToBounds="True" Background="{StaticResource CardBackground}"
                            Opacity="0.5" IsVisible="{Binding HasSecond}" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <c:RemoteImage Url="{Binding SecondCover}" />
                    </Border>
                    <Border Width="162" Height="162" CornerRadius="8" ClipToBounds="True" Background="{StaticResource CardBackground}"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" BoxShadow="0 4 12 0 #66000000">
                        <Panel>
                            <TextBlock Text="&#xE82D;" FontFamily="{StaticResource IconFont}" FontSize="36" Opacity="0.35"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <c:RemoteImage Url="{Binding Cover}" />
                        </Panel>
                    </Border>
                </Panel>
            </Button>
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Secondary}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- One song in a list: number or artwork, title, artist and length; right-click for more. -->
    <DataTemplate x:Key="TrackCard" x:DataType="vm:TrackItem">
        <Button Command="{Binding Play}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,8"
                CornerRadius="10" Classes="track" Classes.current="{Binding IsCurrent}">
            <Button.ContextMenu>
                <ContextMenu ItemsSource="{Binding Actions}" IsVisible="{Binding HasActions}">
                    <ContextMenu.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrackAction">
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </ContextMenu.ItemTemplate>
                    <ContextMenu.ItemContainerTheme>
                        <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:TrackAction">
                            <Setter Property="Command" Value="{Binding Command}" />
                        </ControlTheme>
                    </ContextMenu.ItemContainerTheme>
                </ContextMenu>
            </Button.ContextMenu>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Panel Grid.Column="0" Width="44" Margin="0,0,12,0">
                    <Border Width="44" Height="44" CornerRadius="6" ClipToBounds="True" Background="{StaticResource CardBackground}"
                            IsVisible="{Binding ShowsArtwork}">
                        <c:RemoteImage Url="{Binding Artwork}" />
                    </Border>
                    <TextBlock Text="{Binding Number}" Foreground="{StaticResource Secondary}" FontWeight="Medium"
                               HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding ShowsNumber}" />
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Secondary}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding IsCurrent}" />
                </Panel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding Artist, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="&#xEB52;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="12,0"
                           Foreground="{StaticResource Secondary}" VerticalAlignment="Center" IsVisible="{Binding IsFavorite}" />
                <TextBlock Grid.Column="3" Text="{Binding Length}" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" />
            </Grid>
        </Button>
    </DataTemplate>

</ResourceDictionary>
