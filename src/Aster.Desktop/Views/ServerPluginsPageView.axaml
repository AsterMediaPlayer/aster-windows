<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.Desktop.ViewModels"
             x:Class="Aster.Desktop.Views.ServerPluginsPageView"
             x:DataType="vm:ServerPluginsPageViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://Aster.Desktop/Views/SettingsStyles.axaml" />
        <StyleInclude Source="avares://Aster.Desktop/Views/PluginStyles.axaml" />

        <Style Selector="Button.row TextBlock.cardText, Button.row TextBlock.status">
            <Setter Property="Foreground" Value="#99FFFFFF" />
        </Style>
        <Style Selector="Button.row:pointerover TextBlock.cardText, Button.row:focus-visible TextBlock.cardText, Button.row:pointerover TextBlock.status, Button.row:focus-visible TextBlock.status">
            <Setter Property="Foreground" Value="#8C000000" />
        </Style>
    </UserControl.Styles>

    <!-- Settings ▸ Server Plugins: each companion plugin a row, an administrator's turning it
         on and off, then the restart a change waits on, Aurora, and the welcome screen again. -->
    <Panel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="48,76,48,60" DataContext="{Binding Plugins}" x:DataType="vm:ServerPluginsViewModel">
                <TextBlock Classes="pageTitle" Text="Server Plugins" />

                <ProgressBar IsIndeterminate="True" Width="200" HorizontalAlignment="Center" Margin="0,40" IsVisible="{Binding IsLoading}" />

                <ItemsControl ItemsSource="{Binding Plugins}" IsVisible="{Binding !IsLoading}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PluginRow">
                            <Button Classes="row" Command="{Binding FlipCommand}"
                                    AutomationProperties.Name="{Binding PackageName}">
                                <DockPanel>
                                    <TextBlock Classes="value" Text="{Binding OnOff}" IsVisible="{Binding ShowsSwitch}" />
                                    <TextBlock Classes="icon" Text="{Binding Icon}" VerticalAlignment="Top" Margin="0,2,16,0" />
                                    <StackPanel Spacing="2" Margin="0,4">
                                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                            <Run Text="{Binding Headline}" /><Run Text=" · " /><Run Text="{Binding PackageName}" />
                                        </TextBlock>
                                        <TextBlock Classes="cardText" FontSize="14" Text="{Binding Summary}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0" IsVisible="{Binding Caption, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <ProgressBar IsIndeterminate="True" Width="16" MinWidth="16" VerticalAlignment="Center" IsVisible="{Binding IsInstalling}" />
                                            <TextBlock Classes="status" Classes.good="{Binding IsGood}" Text="{Binding Caption}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Classes="note" IsVisible="{Binding IsAdmin}">
                    <TextBlock Text="Free plugins for Jellyfin that add more to Aster. Switching one on installs it on your server; off turns it off and keeps its settings. Either takes a server restart." />
                </Border>

                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RestartControls}" Margin="22,8,22,16" />

                <TextBlock Classes="section" Text="MORE" />
                <Border Classes="note">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Aster Aurora, for the web" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Brings as much of Aster as it can to Jellyfin in your browser: big hero banners, trailers playing behind titles, and more. Once Aster's repository is on your server, you'll find it in the plugin catalogue in Jellyfin's dashboard." />
                    </StackPanel>
                </Border>
                <Border Classes="note" IsVisible="{Binding IsNotAdmin}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Want these? Ask whoever runs your server" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="They can switch them on from Aster in a few seconds, or add this repository under Plugins ▸ Repositories in Jellyfin's dashboard:" />
                        <SelectableTextBlock Classes="address" Text="{Binding RepositoryUrl}" />
                    </StackPanel>
                </Border>

                <Button Classes="row" Margin="0,16,0,8" Command="{Binding $parent[UserControl].((vm:ServerPluginsPageViewModel)DataContext).ShowWelcomeCommand}">
                    <TextBlock Text="Show Welcome Screen" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </ScrollViewer>
        <!-- Back, for the pointer: the page sits over its tab. -->
        <Button x:Name="BackButton" ToolTip.Tip="Back (Alt+←)" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20"
                Width="44" Height="44" CornerRadius="22" Background="#B3000000" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0">
            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" />
        </Button>
    </Panel>
</UserControl>
