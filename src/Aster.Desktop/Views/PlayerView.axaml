<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.Desktop.ViewModels"
             xmlns:c="using:Aster.Desktop.Controls"
             xmlns:anime="using:Aster.Core.Anime"
             x:Class="Aster.Desktop.Views.PlayerView"
             x:DataType="vm:PlayerViewModel"
             Focusable="True"
             Background="Black">

    <UserControl.Styles>
        <Style Selector="TextBlock.icon">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style Selector="Button.bar">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <!-- The channel row's cards: faint, lighter and outlined when picked. -->
        <Style Selector="Button.flickCard">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.flickCard.selected">
            <Setter Property="Background" Value="#38FFFFFF" />
            <Setter Property="BorderBrush" Value="#E6FFFFFF" />
        </Style>
        <Style Selector="Button.flickCard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#30FFFFFF" />
        </Style>
        <Style Selector="Button.flickCard.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#38FFFFFF" />
            <Setter Property="BorderBrush" Value="#E6FFFFFF" />
        </Style>
        <Style Selector="Button.goTo">
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="20,9" />
        </Style>
        <Style Selector="Button.goTo.picked">
            <Setter Property="Background" Value="#D9FFFFFF" />
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style Selector="Button.goTo.picked TextBlock">
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style Selector="Button.pill">
            <Setter Property="Background" Value="#E6FFFFFF" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="CornerRadius" Value="20" />
        </Style>
        <Style Selector="Button.pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style Selector="Button.pill.secondary">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.pill.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#55FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <ControlTheme x:Key="ChoiceItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:TrackChoice">
            <Setter Property="Header" Value="{Binding Title}" />
            <Setter Property="Command" Value="{Binding Select}" />
            <Setter Property="ToggleType" Value="Radio" />
            <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
        </ControlTheme>
        <ControlTheme x:Key="ChapterItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:ChapterChoice">
            <Setter Property="Header" Value="{Binding}" />
            <Setter Property="HeaderTemplate">
                <DataTemplate x:DataType="vm:ChapterChoice">
                    <DockPanel MinWidth="240">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Opacity="0.7" Margin="24,0,0,0" />
                        <TextBlock Text="{Binding Title}" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </DataTemplate>
            </Setter>
            <Setter Property="Command" Value="{Binding Select}" />
            <Setter Property="ToggleType" Value="Radio" />
            <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}" />
        </ControlTheme>
    </UserControl.Resources>

    <Grid x:Name="Surface" Background="Transparent">
        <c:MpvVideoView Player="{Binding Player}" />

        <!-- A Channel's bug: faint in a corner of the picture, placed in code. -->
        <Canvas x:Name="BugLayer" IsHitTestVisible="False">
            <c:RemoteImage x:Name="Bug" Url="{Binding BugUrl}" Width="{Binding BugWidth}" Height="{Binding BugWidth}" Stretch="Uniform"
                           Opacity="{Binding BugOpacity}">
                <c:RemoteImage.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.8" />
                    </Transitions>
                </c:RemoteImage.Transitions>
            </c:RemoteImage>
        </Canvas>

        <!-- Until the first frame: the title, and that it's on its way. -->
        <StackPanel IsVisible="{Binding !HasStarted}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <TextBlock Text="{Binding Title}" FontSize="32" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Subtitle}" FontSize="16" Foreground="#CCFFFFFF" HorizontalAlignment="Center" />
            <ProgressBar IsIndeterminate="True" Width="200" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNull}}" />
        </StackPanel>

        <Border IsVisible="{Binding IsBuffering}" Background="#A0000000" CornerRadius="10" Padding="20,14"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="10">
                <TextBlock Text="Loading…" Foreground="White" HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" Width="140" />
            </StackPanel>
        </Border>

        <!-- An opening's or ending's song card, in the lower left like a music channel's credit;
             lifted above the timeline or the channel row while they're up, never behind them. -->
        <Panel x:Name="ThemeCardLayer" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Bottom" Opacity="{Binding ThemeCardOpacity}">
            <Panel.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.6" Easing="SineEaseInOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="SineEaseInOut" />
                </Transitions>
            </Panel.Transitions>
            <!-- A soft shade from the corner, so the text reads over bright frames. -->
            <Border Width="520" Height="240" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <Border.Background>
                    <RadialGradientBrush Center="0%,100%" GradientOrigin="0%,100%" RadiusX="100%" RadiusY="100%">
                        <GradientStop Offset="0" Color="#8C000000" />
                        <GradientStop Offset="0.55" Color="#4D000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <!-- Bound to the card itself, which is null until the first one shows. -->
            <DockPanel MaxWidth="420" Margin="24,0,0,40" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       DataContext="{Binding ThemeCard}" x:DataType="anime:ThemeInfo">
                <DockPanel.Effect>
                    <DropShadowEffect BlurRadius="12" OffsetX="0" OffsetY="2" Color="Black" Opacity="0.7" />
                </DockPanel.Effect>
                <Border DockPanel.Dock="Left" Width="3" CornerRadius="2" Background="White" Margin="0,0,12,0" />
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding $parent[UserControl].((vm:PlayerViewModel)DataContext).ThemeCardKicker}" FontSize="12" FontWeight="SemiBold" LetterSpacing="2.5" Foreground="#BFFFFFFF" />
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="White"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Artists}" FontSize="15" FontWeight="Medium" Foreground="White" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding Artists, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding Series}" FontSize="13" FontWeight="SemiBold" Foreground="#E6FFFFFF" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding Series, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </DockPanel>
        </Panel>

        <!-- The controls, shown on mouse movement and while paused. -->
        <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding ControlsVisible}">
            <Border Grid.Row="0" Padding="16,12,24,40">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#B0000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <Button Classes="bar" DockPanel.Dock="Left" Command="{Binding CloseCommand}" ToolTip.Tip="Back (Esc)">
                        <TextBlock Classes="icon" Text="&#xE72B;" />
                    </Button>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" IsVisible="{Binding !ShowsPauseInfo}">
                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="14" Foreground="#CCFFFFFF" />
                    </StackPanel>
                    <!-- Paused: the title's logo in its name's place (or the name, large, when there's none). -->
                    <Panel Margin="16,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding ShowsPauseInfo}">
                        <TextBlock Text="{Binding PauseName}" FontSize="34" FontWeight="Heavy" Foreground="White" TextWrapping="Wrap" MaxLines="2"
                                   MaxWidth="600" IsVisible="{Binding !#PauseLogo.HasImage}" />
                        <c:RemoteImage x:Name="PauseLogo" Url="{Binding PauseLogoUrl}" MaxWidth="420" MaxHeight="150" Stretch="Uniform"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </Panel>
                </DockPanel>
            </Border>

            <Border x:Name="BottomBar" Grid.Row="2" Padding="24,48,24,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#00000000" />
                        <GradientStop Offset="1" Color="#C0000000" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Spacing="4">
                    <!-- Paused: what it is, its description drifting slowly up so it can be read to the end, and what the stream is. -->
                    <Border IsVisible="{Binding ShowsPauseInfo}" MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,18" Padding="24,20"
                            CornerRadius="22" Background="#B3101010" BorderThickness="1" BorderBrush="#1FFFFFFF">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="4" IsVisible="{Binding PauseHeading, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="{Binding PauseHeading}" FontSize="22" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding PauseSubheading}" FontSize="15" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding PauseSubheading, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                            <c:AutoScrollText Text="{Binding PauseOverview}" TextElement.FontSize="17" TextElement.Foreground="#BFFFFFFF"
                                              IsVisible="{Binding PauseOverview, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding PauseFacts}" FontSize="15" Foreground="#D9FFFFFF" VerticalAlignment="Center"
                                           IsVisible="{Binding PauseFacts, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <ItemsControl ItemsSource="{Binding PauseBadges}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border CornerRadius="5" Padding="7,1" BorderBrush="White" BorderThickness="2" Background="White">
                                                <TextBlock Text="{Binding}" FontSize="11" FontWeight="Heavy" Foreground="Black" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- Live TV and Channels have no timeline: LIVE, or the channel, in its place. -->
                    <Border Background="#E53935" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" IsVisible="{Binding HasBadge}">
                        <TextBlock Text="{Binding Badge}" Foreground="White" FontWeight="Bold" FontSize="12" LetterSpacing="1" />
                    </Border>
                    <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasTimeline}">
                        <TextBlock Grid.Column="0" Text="{Binding PositionText}" Foreground="White" VerticalAlignment="Center" MinWidth="56" />
                        <Panel Grid.Column="1" Margin="8,0">
                            <Slider x:Name="SeekBar" Minimum="0" Maximum="{Binding Duration}" Value="{Binding SeekBarValue}" />
                            <!-- A mark under the bar at each chapter, placed in code. -->
                            <Canvas x:Name="ChapterMarks" IsHitTestVisible="False" />
                            <!-- The frame and time above the point on the bar under the pointer, or dragged to; placed in code. -->
                            <Canvas x:Name="PreviewLayer" IsHitTestVisible="False">
                                <StackPanel x:Name="PreviewBubble" Spacing="6"
                                            IsVisible="{Binding PreviewSeconds, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Border CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Center"
                                            IsVisible="{Binding PreviewFrame, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Image Source="{Binding PreviewFrame}" Width="200" Stretch="Uniform" />
                                    </Border>
                                    <Border Background="#99000000" CornerRadius="12" Padding="10,4" HorizontalAlignment="Center">
                                        <StackPanel>
                                            <TextBlock Text="{Binding PreviewChapter}" FontSize="12" Foreground="#CCFFFFFF" MaxWidth="200"
                                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                                                       IsVisible="{Binding PreviewChapter, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <TextBlock Text="{Binding PreviewTime}" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Canvas>
                        </Panel>
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="White" VerticalAlignment="Center" MinWidth="56" TextAlignment="Right" />
                    </Grid>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4">
                            <Button Classes="bar" Command="{Binding TogglePauseCommand}" ToolTip.Tip="Play/Pause (Space)">
                                <Panel>
                                    <TextBlock Classes="icon" Text="&#xE768;" IsVisible="{Binding IsPaused}" />
                                    <TextBlock Classes="icon" Text="&#xE769;" IsVisible="{Binding !IsPaused}" />
                                </Panel>
                            </Button>
                            <Button Classes="bar" Command="{Binding Back10Command}" Content="−10" ToolTip.Tip="Back 10 seconds (←)" IsVisible="{Binding HasTimeline}" />
                            <Button Classes="bar" Command="{Binding Forward10Command}" Content="+10" ToolTip.Tip="Forward 10 seconds (→)" IsVisible="{Binding HasTimeline}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                            <Button Classes="bar" Command="{Binding ShowChannelsCommand}" IsVisible="{Binding HasBadge}" ToolTip.Tip="Channels (↑)"
                                    AutomationProperties.Name="Channels">
                                <TextBlock Classes="icon" Text="&#xE8FD;" />
                            </Button>
                            <Button Classes="bar" IsVisible="{Binding HasChapters}" ToolTip.Tip="Chapters (Page Up, Page Down)"
                                    AutomationProperties.Name="Chapters">
                                <TextBlock Classes="icon" Text="&#xE8FD;" />
                                <Button.Flyout>
                                    <MenuFlyout ItemsSource="{Binding ChapterChoices}" ItemContainerTheme="{StaticResource ChapterItem}" />
                                </Button.Flyout>
                            </Button>
                            <Button Classes="bar" ToolTip.Tip="Audio">
                                <TextBlock Classes="icon" Text="&#xE8D6;" />
                                <Button.Flyout>
                                    <MenuFlyout ItemsSource="{Binding AudioChoices}" ItemContainerTheme="{StaticResource ChoiceItem}" />
                                </Button.Flyout>
                            </Button>
                            <Button Classes="bar" ToolTip.Tip="Subtitles">
                                <TextBlock Classes="icon" Text="&#xE7F0;" />
                                <Button.Flyout>
                                    <MenuFlyout ItemsSource="{Binding SubtitleChoices}" ItemContainerTheme="{StaticResource ChoiceItem}" />
                                </Button.Flyout>
                            </Button>
                            <Button Classes="bar" Content="Speed" IsVisible="{Binding HasTimeline}">
                                <Button.Flyout>
                                    <MenuFlyout ItemsSource="{Binding SpeedChoices}" ItemContainerTheme="{StaticResource ChoiceItem}" />
                                </Button.Flyout>
                            </Button>
                            <Button Classes="bar" Content="Quality" IsVisible="{Binding OffersQuality}">
                                <Button.Flyout>
                                    <MenuFlyout ItemsSource="{Binding QualityChoices}" ItemContainerTheme="{StaticResource ChoiceItem}" />
                                </Button.Flyout>
                            </Button>
                            <Button Classes="bar" x:Name="FullScreenButton" ToolTip.Tip="Full screen (F)">
                                <TextBlock Classes="icon" Text="&#xE740;" />
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- The channel row (Up on a channel): what's on the picked channel, then the channels either side of it. -->
        <Border x:Name="FlickRow" DataContext="{Binding Flick}" x:DataType="vm:ChannelFlickViewModel"
                IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}"
                VerticalAlignment="Bottom" Margin="48,0,48,36" Padding="28" CornerRadius="28" Background="#E01C1C1C"
                BoxShadow="0 12 40 0 #80000000">
            <StackPanel Spacing="22">
                <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="150">
                    <Border Width="267" Height="150" CornerRadius="12" ClipToBounds="True" Background="#14FFFFFF" VerticalAlignment="Top"
                            IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <c:RemoteImage Url="{Binding Image}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="24,0,16,0" Spacing="6">
                        <TextBlock Text="{Binding ChannelLine}" FontSize="16" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding Subtitle, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Text="{Binding Overview}" Foreground="#BFFFFFFF" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding Overview, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <TextBlock Text="{Binding TimeRange}" Foreground="#BFFFFFFF" VerticalAlignment="Center" />
                            <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Width="160" Height="5" MinHeight="5" CornerRadius="3"
                                         Foreground="White" Background="#40FFFFFF" VerticalAlignment="Center" IsVisible="{Binding HasProgress}" />
                            <TextBlock Text="{Binding TimeLeft}" Foreground="#BFFFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="22" Margin="0,6,0,0">
                            <Button Classes="goTo" Classes.picked="{Binding IsOnGoTo}" IsVisible="{Binding CanGoTo}"
                                    Command="{Binding $parent[UserControl].((vm:PlayerViewModel)DataContext).FlickGoToCommand}"
                                    AutomationProperties.Name="{Binding GoToTitle}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE70E;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding GoToTitle}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" Foreground="#99FFFFFF" VerticalAlignment="Center"
                                           IsVisible="{Binding IsCurrentSelected}" />
                                <TextBlock Text="&#xEA3A;" FontFamily="{StaticResource IconFont}" Foreground="White" VerticalAlignment="Center"
                                           IsVisible="{Binding !IsCurrentSelected}" />
                                <TextBlock Text="{Binding WatchHint}" FontWeight="SemiBold" Foreground="White" Opacity="{Binding IsCurrentSelected, Converter={x:Static c:Converters.DimWhen}}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <!-- The channel's bug, in the top right beside what's on. -->
                    <c:RemoteImage Grid.Column="2" Url="{Binding Bug}" Width="180" MaxHeight="110" Stretch="Uniform" VerticalAlignment="Top" />
                </Grid>

                <!-- The picked channel's group, when channels have groups: it changes as flicking crosses into the next. -->
                <TextBlock Text="{Binding SelectedGroup}" IsVisible="{Binding SelectedGroup, Converter={x:Static ObjectConverters.IsNotNull}}"
                           HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="#B3FFFFFF" Margin="0,0,0,-12" />

                <!-- Five places sharing the width, an empty one kept where the row is short. -->
                <ItemsControl ItemsSource="{Binding Cards}" Margin="-8,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FlickCard">
                            <Button Classes="flickCard" Classes.selected="{Binding IsSelected}" Height="104" Margin="8,0" HorizontalAlignment="Stretch"
                                    Opacity="{Binding IsEmpty, Converter={x:Static c:Converters.HiddenWhen}}" IsHitTestVisible="{Binding !IsEmpty}"
                                    Command="{Binding $parent[UserControl].((vm:PlayerViewModel)DataContext).FlickToCommand}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Channel.Name}">
                                <Grid RowDefinitions="Auto,*,Auto" Margin="14,12">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#B3FFFFFF"
                                                   VerticalAlignment="Center" IsVisible="{Binding IsCurrent}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Channel.Number}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                            <Panel>
                                                <TextBlock Text="{Binding Channel.Name}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"
                                                           MaxWidth="150" VerticalAlignment="Center" IsVisible="{Binding !#FlickLogo.HasImage}" />
                                                <c:RemoteImage x:Name="FlickLogo" Url="{Binding Channel.Logo}" Height="26" MaxWidth="130" Stretch="Uniform" HorizontalAlignment="Left" />
                                            </Panel>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding Channel.Now.Title}" FontSize="12" Foreground="#CCFFFFFF" TextWrapping="Wrap" MaxLines="2"
                                               TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                                    <ProgressBar Grid.Row="2" Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="4" MinHeight="4" CornerRadius="2"
                                                 Foreground="White" Background="#40FFFFFF" IsVisible="{Binding HasProgress}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border IsVisible="{Binding Toast, Converter={x:Static ObjectConverters.IsNotNull}}" Background="#C0000000" CornerRadius="8"
                Padding="16,10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,110,0,0">
            <TextBlock Text="{Binding Toast}" Foreground="White" FontSize="16" />
        </Border>

        <!-- Skip Intro / Skip Credits / Play Next Episode. -->
        <Button Classes="pill" Content="{Binding SkipTitle}" Command="{Binding SkipCommand}"
                IsVisible="{Binding SkipVisible}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,140" />

        <!-- Playback keeps stalling. -->
        <Border IsVisible="{Binding QualityOfferVisible}" Background="#E0202020" CornerRadius="12" Padding="20"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,96,0,0" MaxWidth="460">
            <StackPanel Spacing="12">
                <TextBlock Text="Playback keeps pausing to load." FontSize="16" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="A lower quality may play smoothly on this connection." TextWrapping="Wrap" Foreground="#CCFFFFFF" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Lower Quality" Command="{Binding LowerQualityCommand}" />
                    <Button Content="Keep Trying" Command="{Binding KeepTryingCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Up Next, after an episode ends. -->
        <Border IsVisible="{Binding EndCardVisible}" Background="#E0181818" CornerRadius="12" Padding="24"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,48" MinWidth="380">
            <StackPanel Spacing="10">
                <TextBlock Text="Up Next" FontSize="14" Foreground="#AAFFFFFF" />
                <TextBlock Text="{Binding UpNextTitle}" FontSize="18" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" MaxWidth="420" />
                <TextBlock Text="{Binding CountdownText}" Foreground="#CCFFFFFF" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                    <Button Classes="pill" Content="Play Now" Command="{Binding PlayUpNextNowCommand}" />
                    <Button Classes="pill secondary" Content="Close" Command="{Binding DismissEndCardCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Can't play. -->
        <Border IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" Background="#F0202020"
                CornerRadius="12" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
            <StackPanel Spacing="12">
                <TextBlock Text="Can't Play" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#CCFFFFFF" />
                <Button Content="Close" Command="{Binding CloseCommand}" HorizontalAlignment="Right" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
