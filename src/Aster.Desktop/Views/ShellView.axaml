<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.Desktop.ViewModels"
             xmlns:c="using:Aster.Desktop.Controls"
             xmlns:v="using:Aster.Desktop.Views"
             xmlns:mpv="using:Aster.Mpv"
             x:Class="Aster.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel">

    <UserControl.Styles>
        <!-- A tab, as on the Apple TV: an icon and its name; the tab showing on a soft
             capsule, the one under the keyboard or pointer a white one, dark text on it. -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.nav TextBlock.icon">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Width" Value="24" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.nav.selected">
            <Setter Property="Background" Value="#2EFFFFFF" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F2FFFFFF" />
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style Selector="Button.nav:focus-visible /template/ ContentPresenter">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="BoxShadow" Value="0 6 18 0 #66000000" />
        </Style>
        <!-- The sidebar: off to the left until it's open, then floating over the page. -->
        <Style Selector="Border.sidebar">
            <Setter Property="RenderTransform" Value="translateX(-340px)" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.sidebar.open">
            <Setter Property="RenderTransform" Value="translateX(0px)" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Border.scrim">
            <Setter Property="Background" Value="#8C000000" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.scrim.open">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <!-- The capsule makes way for the sidebar it opens into, rather than showing through its glass. -->
        <Style Selector="StackPanel.collapsed">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.collapsed.hidden">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <!-- The collapsed sidebar: the tab's icon and name in a capsule, as on the Apple TV. -->
        <Style Selector="Button.capsule">
            <Setter Property="Background" Value="#B3202020" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="14,8,18,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.capsule:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E6303030" />
        </Style>
        <Style Selector="Button.bar">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- A title's theme video, behind its page (whose backdrop fades from over it). Here rather than in the page, as
             mpv's video can't move between views: a series and its episode share one. The view leaves with the video,
             letting go of mpv's render context as it does. -->
        <ContentControl Content="{Binding Theme.Video}" IsVisible="{Binding ShowsThemeVideo}" IsHitTestVisible="False" Focusable="False">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="mpv:MpvPlayer">
                    <c:MpvVideoView Player="{Binding}" />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- The page, the whole width of the window. -->
        <ContentControl x:Name="Page" Content="{Binding CurrentPage}" />

        <!-- Collapsed: the tab in a capsule (on a tab's own page; a page opened from one has its Back there), and the song or book playing. -->
        <StackPanel Classes="collapsed" Classes.hidden="{Binding IsSidebarOpen}" Orientation="Horizontal" Spacing="10" Margin="20,16,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding ShowsCapsule}">
            <Button x:Name="Capsule" Classes="capsule" Command="{Binding OpenSidebarCommand}" AutomationProperties.Name="Show the sidebar"
                    ToolTip.Tip="Tabs">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Opacity="0.7" />
                    <TextBlock Text="{Binding CurrentTab.Glyph}" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentTab.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Border Background="#B3202020" CornerRadius="20" Padding="4,4,8,4" BorderThickness="1" BorderBrush="#1FFFFFFF"
                    IsVisible="{Binding Audio.IsLoaded}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Command="{Binding Audio.ShowPlayerCommand}" Background="Transparent" Padding="0" ToolTip.Tip="{Binding Audio.Title}"
                            AutomationProperties.Name="Now Playing">
                        <Border Width="30" Height="30" CornerRadius="15" ClipToBounds="True" Background="{StaticResource CardBackground}">
                            <c:RemoteImage Url="{Binding Audio.Artwork}" />
                        </Border>
                    </Button>
                    <Button Classes="bar" Command="{Binding Audio.ToggleCommand}" AutomationProperties.Name="Play or Pause" ToolTip.Tip="Play/Pause (Space)">
                        <Panel>
                            <TextBlock Text="&#xE769;" IsVisible="{Binding Audio.IsPlaying}" />
                            <TextBlock Text="&#xE768;" IsVisible="{Binding !Audio.IsPlaying}" />
                        </Panel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- The Music tab's Now Playing panel, at the top right over every page, or filling the window full screen. -->
        <v:ThemeDeckView DataContext="{Binding Deck}" />

        <!-- The window's left edge: the pointer there slides the sidebar out. -->
        <Border x:Name="Edge" Width="6" HorizontalAlignment="Left" Background="Transparent" />

        <!-- Open: the page dims, and a click on it puts the sidebar away. -->
        <Border x:Name="Scrim" Classes="scrim" Classes.open="{Binding IsSidebarOpen}" />

        <!-- The sidebar, floating over the page while it's open: a pane of dark glass, as the Apple TV's. -->
        <Border x:Name="Sidebar" Classes="sidebar" Classes.open="{Binding IsSidebarOpen}" Width="300" HorizontalAlignment="Left" Margin="20"
                CornerRadius="32" BorderThickness="1" BorderBrush="#2EFFFFFF" Padding="10,12"
                BoxShadow="0 16 48 0 #A6000000">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#E6232A2E" />
                    <GradientStop Offset="1" Color="#F0111416" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <!-- The song or book playing, whichever page is showing: the rest opens the full player. -->
                <Border DockPanel.Dock="Bottom" Background="#1FFFFFFF" CornerRadius="20" Padding="8" Margin="0,12,0,0" IsVisible="{Binding Audio.IsLoaded}">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Button Command="{Binding Audio.ShowPlayerCommand}" Background="Transparent" Padding="0" AutomationProperties.Name="Now Playing"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" ToolTip.Tip="Open the player">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="40" Height="40" CornerRadius="8" ClipToBounds="True" Background="{StaticResource CardBackground}">
                                    <c:RemoteImage Url="{Binding Audio.Artwork}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Audio.Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Audio.Detail}" FontSize="12" Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Grid.Column="1" Classes="bar" Command="{Binding Audio.ToggleCommand}" AutomationProperties.Name="Play or Pause" ToolTip.Tip="Play/Pause (Space)">
                            <Panel>
                                <TextBlock Text="&#xE769;" IsVisible="{Binding Audio.IsPlaying}" />
                                <TextBlock Text="&#xE768;" IsVisible="{Binding !Audio.IsPlaying}" />
                            </Panel>
                        </Button>
                        <Button Grid.Column="2" Classes="bar" Command="{Binding Audio.StopCommand}" AutomationProperties.Name="Stop" Content="&#xE711;" FontSize="11"
                                Foreground="{StaticResource Secondary}" ToolTip.Tip="Stop" />
                    </Grid>
                </Border>
                <!-- Every tab, Settings and Search at the foot; they scroll when a short window has no room for them all. -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TabList" ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SidebarTab">
                                <Button Classes="nav" Classes.selected="{Binding IsSelected}" Command="{Binding Select}" AutomationProperties.Name="{Binding Title}">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock Classes="icon" Text="{Binding Glyph}" />
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- The full player, over everything, while it's open. -->
        <v:NowPlayingView DataContext="{Binding NowPlaying}" IsVisible="{Binding IsShown}" />
    </Panel>
</UserControl>
