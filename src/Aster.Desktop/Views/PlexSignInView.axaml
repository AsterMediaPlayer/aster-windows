<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.Desktop.ViewModels"
             x:Class="Aster.Desktop.Views.PlexSignInView"
             x:DataType="vm:PlexSignInViewModel">

    <StackPanel Width="380" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Sign in with Plex" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />

        <!-- The code to enter at plex.tv/link. -->
        <StackPanel Spacing="8" IsVisible="{Binding Code, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="On your phone or computer, go to" Opacity="0.7" HorizontalAlignment="Center" />
            <TextBlock Text="plex.tv/link" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="and enter this code:" Opacity="0.7" HorizontalAlignment="Center" />
            <SelectableTextBlock Text="{Binding Code}" FontFamily="Consolas, monospace" FontSize="44" FontWeight="Bold"
                                 LetterSpacing="12" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="40" VerticalAlignment="Center" />
                <TextBlock Text="Waiting for the code to be entered…" Opacity="0.7" />
            </StackPanel>
        </StackPanel>

        <!-- Who's watching: a Plex Home's people. -->
        <StackPanel Spacing="8" IsVisible="{Binding HasUsers}">
            <TextBlock Text="Who's watching?" FontSize="18" Opacity="0.7" HorizontalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding Users}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlexUserChoice">
                        <Button Command="{Binding Pick}" HorizontalAlignment="Stretch" Margin="0,0,0,6" Padding="14,10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="&#xE72E;" FontFamily="{StaticResource IconFont}" Opacity="0.6"
                                           VerticalAlignment="Center" IsVisible="{Binding HasPin}" AutomationProperties.Name="PIN" />
                                <TextBlock Text="{Binding Title}" />
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Their PIN. -->
        <StackPanel Spacing="8" IsVisible="{Binding PinUser, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding PinPrompt}" FontSize="18" Opacity="0.7" HorizontalAlignment="Center" />
            <TextBox Text="{Binding Pin}" PasswordChar="•" HorizontalAlignment="Center" Width="160" TextAlignment="Center" />
            <TextBlock Text="{Binding PinError}" Foreground="#FF8A80" HorizontalAlignment="Center"
                       IsVisible="{Binding PinError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Button Content="Continue" Command="{Binding SubmitPinCommand}" IsDefault="True"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </StackPanel>

        <!-- Which server. -->
        <StackPanel Spacing="8" IsVisible="{Binding HasServers}">
            <TextBlock Text="Choose a server" FontSize="18" Opacity="0.7" HorizontalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding Servers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlexServerChoice">
                        <Button Command="{Binding Pick}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="14,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.7" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Starting, finding servers, connecting. -->
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center"
                    IsVisible="{Binding Progress, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ProgressBar IsIndeterminate="True" Width="40" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Progress}" Opacity="0.7" />
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding Failure, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Failure}" Foreground="#FF8A80" TextWrapping="Wrap" TextAlignment="Center" />
            <Button Content="Try Again" Command="{Binding StartCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </StackPanel>

        <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Center" Margin="0,10,0,0" />
    </StackPanel>
</UserControl>
