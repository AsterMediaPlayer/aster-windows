<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.Desktop.ViewModels"
             x:Class="Aster.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://Aster.Desktop/Views/SettingsStyles.axaml" />
    </UserControl.Styles>

    <!-- Settings' pages, as the Apple TV lists them: each opens over the list. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="48,76,48,60">
            <TextBlock Classes="pageTitle" Text="Settings" />

            <Button Classes="row" Command="{Binding OpenCommand}" CommandParameter="{x:Static vm:SettingsPage.Playback}">
                <DockPanel>
                    <TextBlock Classes="chevron" />
                    <TextBlock Classes="icon" Text="&#xE768;" />
                    <TextBlock Text="Playback" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button Classes="row" Command="{Binding OpenCommand}" CommandParameter="{x:Static vm:SettingsPage.AudioSubtitles}">
                <DockPanel>
                    <TextBlock Classes="chevron" />
                    <TextBlock Classes="icon" Text="&#xE7F0;" />
                    <TextBlock Text="Audio &amp; Subtitles" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button Classes="row" Command="{Binding OpenCommand}" CommandParameter="{x:Static vm:SettingsPage.DiscMenus}" IsVisible="{Binding IsJellyfin}">
                <DockPanel>
                    <TextBlock Classes="chevron" />
                    <TextBlock Classes="icon" Text="&#xE8B2;" />
                    <TextBlock Text="Disc Menus" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button Classes="row" Command="{Binding OpenCommand}" CommandParameter="{x:Static vm:SettingsPage.TitlePages}">
                <DockPanel>
                    <TextBlock Classes="chevron" />
                    <TextBlock Classes="icon" Text="&#xE7F4;" />
                    <TextBlock Text="Title Pages" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button Classes="row" Command="{Binding OpenChannelsCommand}" IsVisible="{Binding IsJellyfin}">
                <DockPanel>
                    <TextBlock Classes="chevron" />
                    <TextBlock Classes="icon" Text="&#xE714;" />
                    <TextBlock Text="Channels (Beta)" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button Classes="row" Command="{Binding OpenServerPluginsCommand}" IsVisible="{Binding IsJellyfin}">
                <DockPanel>
                    <TextBlock Classes="chevron" />
                    <TextBlock Classes="icon" Text="&#xEA86;" />
                    <TextBlock Text="Server Plugins" VerticalAlignment="Center" />
                </DockPanel>
            </Button>

            <Button Classes="row" Command="{Binding OpenCommand}" CommandParameter="{x:Static vm:SettingsPage.Account}" Margin="0,16,0,8">
                <DockPanel>
                    <TextBlock Classes="chevron" />
                    <TextBlock Classes="value" Text="{Binding UserName}" />
                    <TextBlock Classes="icon" Text="&#xE77B;" />
                    <TextBlock Text="Account" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button Classes="row" Command="{Binding OpenCommand}" CommandParameter="{x:Static vm:SettingsPage.About}">
                <DockPanel>
                    <TextBlock Classes="chevron" />
                    <TextBlock Classes="icon" Text="&#xE8FD;" />
                    <TextBlock Text="About" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
