<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.Desktop.ViewModels"
             x:Class="Aster.Desktop.Views.SignInView"
             x:DataType="vm:SignInViewModel">

    <StackPanel Width="380" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Image Source="/Assets/Images/AsterLogo.png" Stretch="Uniform" HorizontalAlignment="Stretch" Margin="0,0,0,24" />

        <TextBlock Text="Jellyfin or Emby server address" />
        <TextBox Text="{Binding ServerAddress}" />

        <TextBlock Text="User name" Margin="0,8,0,0" />
        <TextBox Text="{Binding UserName}" />

        <TextBlock Text="Password" Margin="0,8,0,0" />
        <TextBox Text="{Binding Password}" PasswordChar="•" />

        <Button Content="Sign In" Command="{Binding SignInCommand}" IsDefault="True"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,16,0,0" />

        <Button Content="Quick Connect" Command="{Binding QuickConnectCommand}"
                IsVisible="{Binding !IsQuickConnecting}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

        <Button Content="Sign in with Plex" Command="{Binding SignInWithPlexCommand}"
                IsVisible="{Binding !IsQuickConnecting}" Margin="0,8,0,0"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

        <StackPanel Spacing="8" Margin="0,16,0,0" IsVisible="{Binding IsQuickConnecting}">
            <TextBlock Text="Enter this code in Jellyfin on another device, under your user menu ▸ Quick Connect"
                       TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7" />
            <TextBlock Text="{Binding QuickConnectCode}" FontFamily="Consolas, monospace" FontSize="44" FontWeight="Bold"
                       LetterSpacing="12" HorizontalAlignment="Center" />
            <Button Content="Cancel" Command="{Binding CancelQuickConnectCommand}"
                    HorizontalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#FF8A80"
                   IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- Servers already signed in to: back to one without typing it. -->
        <StackPanel Spacing="8" Margin="0,24,0,0" IsVisible="{Binding HasServers}">
            <TextBlock Text="Your Servers" FontWeight="SemiBold" Opacity="0.7" HorizontalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding Servers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ServerChoice">
                        <Button Command="{Binding Use}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="14,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.7" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
