<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.Desktop.ViewModels"
             x:Class="Aster.Desktop.Views.ServerPasswordView"
             x:DataType="vm:ServerPasswordViewModel">

    <!-- A saved server's password, checked by the server: to switch to it, or to carry on after Lock After. -->
    <StackPanel Width="380" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="44" Opacity="0.6"
                   HorizontalAlignment="Center" IsVisible="{Binding IsLock}" />
        <TextBlock Text="{Binding ServerName}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Prompt}" Opacity="0.7" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16" />

        <TextBox x:Name="PasswordBox" Text="{Binding Password}" PasswordChar="•" PlaceholderText="Password" />

        <Button Command="{Binding CheckCommand}" IsDefault="True"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressBar IsIndeterminate="True" Width="16" MinWidth="16" IsVisible="{Binding IsChecking}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ActionTitle}" />
            </StackPanel>
        </Button>
        <Button Content="{Binding OtherTitle}" Command="{Binding OtherCommand}" IsCancel="True"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#FF8A80" TextAlignment="Center"
                   IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
</UserControl>
